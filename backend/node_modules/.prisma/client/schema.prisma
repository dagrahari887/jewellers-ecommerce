generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum PriceType {
  FIXED
  RATE_BASED
}

enum MetalType {
  GOLD
  SILVER
  PLATINUM
}

enum OrderStatus {
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum AppointmentType {
  BRIDAL
  CUSTOM
  SHOPPING
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model User {
  id        String   @id
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CUSTOMER)
  phone     String?
  createdAt DateTime @default(now())

  cart         Cart?
  wishlist     Wishlist?
  orders       Order[]
  appointments Appointment[]
  reviews      Review[]
}

model Category {
  id   String @id
  name String @unique

  products Product[]
}

model Collection {
  id   String @id
  name String @unique

  products Product[]
}

model Product {
  id           String     @id
  sku          String     @unique
  name         String
  description  String     @db.Text
  slug         String     @unique
  categoryId   String
  collectionId String?
  priceType    PriceType  @default(RATE_BASED)
  fixedPrice   Decimal?   @db.Decimal(12, 2)
  metalType    MetalType?
  purity       String?
  grossWeight  Decimal?   @db.Decimal(10, 3)
  netWeight    Decimal?   @db.Decimal(10, 3)
  makingCharge Decimal?   @db.Decimal(10, 2)
  stoneCharge  Decimal?   @db.Decimal(10, 2)
  stock        Int        @default(0)
  tags         Json?
  isFeatured   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  collection    Collection?    @relation(fields: [collectionId], references: [id])
  images        ProductImage[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  reviews       Review[]
}

model ProductImage {
  id        String @id
  url       String @db.Text
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model MetalRate {
  id        String    @id
  metal     MetalType
  purity    String
  rate      Decimal   @db.Decimal(10, 2)
  updatedAt DateTime  @default(now()) @updatedAt
}

model RateHistory {
  id        String    @id
  metal     MetalType
  purity    String
  rate      Decimal   @db.Decimal(10, 2)
  createdAt DateTime  @default(now())
}

model Coupon {
  id             String       @id
  code           String       @unique
  discountType   DiscountType
  value          Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal      @default(0) @db.Decimal(12, 2)
  expiryDate     DateTime
  isActive       Boolean      @default(true)
}

model Banner {
  id           String  @id
  title        String?
  imageUrl     String  @db.Text
  linkUrl      String? @db.Text
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)
}

model Cart {
  id     String @id
  userId String @unique

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Wishlist {
  id     String @id
  userId String @unique

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String @id
  wishlistId String
  productId  String

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

model Order {
  id            String        @id
  orderNumber   String        @unique
  userId        String
  totalAmount   Decimal       @db.Decimal(12, 2)
  status        OrderStatus   @default(CONFIRMED)
  paymentStatus PaymentStatus @default(PENDING)
  address       Json
  createdAt     DateTime      @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id        String  @id
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Appointment {
  id        String            @id
  userId    String
  date      DateTime
  type      AppointmentType
  status    AppointmentStatus @default(PENDING)
  notes     String?           @db.Text
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Review {
  id        String   @id
  rating    Int
  comment   String?  @db.Text
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Settings {
  id             String   @id
  storeName      String?  @default("Baikunthh Jewellers")
  contactEmail   String?
  contactPhone   String?
  whatsappNumber String?
  instagramLink  String?
  gstPercentage  Decimal? @default(3.00) @db.Decimal(5, 2)
  address        String?  @db.Text
}
